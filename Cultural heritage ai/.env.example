# Copy to .env in the backend directory. Replace private placeholders locally.
# Full variable and initialization guide: ../docs/ENVIRONMENT.md and DEPLOYMENT.md
APP_ENV=development
APP_NAME=Cultural Heritage QA Backend
APP_VERSION=0.1.0
DEBUG=false
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=heritage_app
DATABASE_PASSWORD=replace-with-your-local-password
DATABASE_NAME=heritage_competition
JWT_SECRET_KEY=replace-with-a-random-private-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-private-redis-password

RAG_MILVUS_URI=http://127.0.0.1:19530
RAG_MILVUS_TOKEN=
RAG_MILVUS_COLLECTION_NAME=heritage_chunks
RAG_MILVUS_METRIC_TYPE=COSINE
RAG_RETRIEVAL_TOP_K=3
RAG_TASK_RETRIEVAL_TOP_K=4

EMBEDDING_BASE_URL=http://127.0.0.1:8001
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_QUERY_INSTRUCTION=Given a cultural heritage question, retrieve relevant passages that help answer the question.
EMBEDDING_NORMALIZED=true

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com


RERANKER_BASE_URL=http://127.0.0.1:8002
RERANKER_MODEL=qwen3-reranker
RERANKER_TIMEOUT_SECONDS=60
RERANKER_CANDIDATE_TOP_K=20
RERANKER_TOP_K=5

LLM_TIMEOUT_SECONDS=120
LLM_TOOL_TIMEOUT_SECONDS=60
LLM_HEALTH_TIMEOUT_SECONDS=30
AI_HEALTH_CHECK_ON_STARTUP=false
# Optional override; when empty, RAG Task selects an enabled usable Judge via AgentFacade.
RAG_TASK_AGGREGATOR_AI_ID=
# Enable explicitly to consume existing durable jobs; restarting may invoke models/indexing.
RAG_TASK_CONSUMER_ENABLED=false
RAG_TASK_POLL_SECONDS=2
RAG_TASK_LEASE_SECONDS=120
RAG_TASK_MAX_ATTEMPTS=3
RAG_TASK_RETRY_SECONDS=10
HCP_MAD_DEBATE_ENABLED=false
HCP_MAD_DEBATE_POLICY_VERSION=judge-trigger-v1
HCP_MAD_DEBATE_MAX_ROUNDS=3
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=30
