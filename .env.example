# Copy to .env. Never commit the configured file.
APP_ENV=development
APP_NAME=Cultural Heritage QA Backend
APP_VERSION=0.1.0
DEBUG=false
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=cultural_heritage
DATABASE_PASSWORD=replace-with-your-local-password
DATABASE_NAME=aijiu
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

RAG_MILVUS_URI=http://127.0.0.1:19530
RAG_MILVUS_TOKEN=
RAG_MILVUS_COLLECTION_NAME=heritage_chunks
RAG_MILVUS_METRIC_TYPE=COSINE
RAG_RETRIEVAL_TOP_K=3
RAG_TASK_RETRIEVAL_TOP_K=4

EMBEDDING_BASE_URL=http://127.0.0.1:8001
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_QUERY_INSTRUCTION=Given a cultural heritage question, retrieve relevant passages that help answer the question.
EMBEDDING_NORMALIZED=true

DEEPSEEK_API_KEY=你的deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com


RERANKER_BASE_URL=http://127.0.0.1:8002
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_TIMEOUT_SECONDS=60
RERANKER_CANDIDATE_TOP_K=20
RERANKER_TOP_K=5

# Business / aggregator names and URLs are registered through POST /ais.
LLM_TIMEOUT_SECONDS=120
LLM_TOOL_TIMEOUT_SECONDS=60
LLM_HEALTH_TIMEOUT_SECONDS=30
# Set false during frequent development reloads; there is no periodic AI polling.
AI_HEALTH_CHECK_ON_STARTUP=true
# Optional: web_search and fetch_webpage are disabled when this is empty.
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=30
