# Local configuration and credentials; keep shareable templates.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# Python environments, bytecode and generated checks.
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Node/Vue and generic build output.
node_modules/
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo
.eslintcache
*.timestamp-*-*.mjs
.vite/
.nuxt/
.output/

# Java/Maven/Gradle build output (keep wrappers and project manifests).
target/
.gradle/
*.class
*.war
*.ear
hs_err_pid*

# Local IDE, OS and assistant state.
.idea/
.vscode/
.vs/
.agents/
.codex/
.DS_Store
Thumbs.db
Desktop.ini
*.iml
*.suo
*.user
*.swp
*.swo
*~

