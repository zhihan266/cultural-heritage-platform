# Copy to deployment/.env. Replace every required placeholder locally.
MYSQL_DATABASE=heritage_competition
MYSQL_USER=heritage_app
MYSQL_PASSWORD=replace-with-private-app-password
MYSQL_ROOT_PASSWORD=replace-with-private-root-password
MYSQL_PORT=3306
REDIS_PASSWORD=replace-with-private-redis-password
REDIS_PORT=6379
MINIO_ROOT_USER=replace-with-private-minio-user
MINIO_ROOT_PASSWORD=replace-with-private-minio-password
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
